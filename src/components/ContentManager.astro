---
// src/components/ContentManager.astro
const response = await fetch('https://www.dacgrupo.com/wp-json/wp/v2/pages/7303');
const pageData = await response.json();
const rawContent: string = pageData.content.rendered;

// Limpiamos solo los corchetes para mantener el HTML de los títulos
const cleanContent = rawContent.replace(/\[\/?vc_[^\]]*\]/g, "");

// Separamos por h2 para tener bloques
const allSections = cleanContent.split('<h2');

// Función con tipos de TypeScript corregidos
const findSection = (exactText: string) => {
  const section = allSections.find((s: string) => s.includes(exactText));
  return section ? '<h2' + section : null;
};

// Secciones con Títulos Exactos
export const about = findSection('Quiénes somos');
export const misiones = findSection('Misión'); // Esto capturará el bloque de las 3 columnas
export const target = findSection('A quién nos dirigimos');
export const tech = findSection('Asesoramiento técnico');
export const projects = findSection('Déjenos ayudarle a llevar a cabo sus proyectos');
export const training = findSection('Formación');
export const stock = findSection('Stock');
export const postVenta = findSection('Post-venta');
export const marcas = findSection('Nuestras Marcas');
export const catalogo = findSection('Catálogo interactivo');
export const servicios = findSection('Nuestros servicios');
---

<style is:global>
  
  /* 1. IMPORTANTE: Esto le dice a este bloque de CSS dónde están las definiciones de Tailwind */
  @reference "../styles/global.css";
  
  /* Fix para que el HTML sucio de WP se vea como 3 columnas en Tailwind */
  .wp-grid-fix .vc_row {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 2rem;
  }
  
  @media (min-width: 768px) {
    .wp-grid-fix .vc_row {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .wp-grid-fix h2 {
    @apply text-2xl font-bold text-center mt-4 mb-2;
  }
</style>