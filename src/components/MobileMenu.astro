---
// Aquí puedes poner los enlaces específicos que viste en el inspector de DAC
const mobileItems = [
  { name: 'dacgrupo', url: '/' },
  { name: 'Catálogo DAC', url: '/catalogo-dac/' },
];
---

<div id="mobile-menu" class="hidden md:hidden bg-white border-t border-gray-100 w-full absolute left-0 top-22.5 z-40 shadow-lg">
  <nav id="tf_mb_menu" class="menu">
    <ul class="flex flex-col p-6 space-y-4">
      {mobileItems.map((item) => (
        <li class="border-b border-gray-50 pb-2">
          <a 
            href={item.url} 
            class="text-[16px] font-medium text-[#777] hover:text-[#333] transition-colors block"
          >
            {item.name}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<script>
  // Esta lógica se encarga de escuchar el evento que lanzará el botón del Navbar
  const menu = document.getElementById('mobile-menu');
  
  // Escuchamos un evento personalizado para abrir/cerrar
  document.addEventListener('toggle-menu', () => {
    menu?.classList.toggle('hidden');
  });
</script>
