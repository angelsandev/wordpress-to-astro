---
import MobileMenu from "./MobileMenu.astro";

// Definimos el menú EXACTAMENTE con las URLs de DAC
const navItems = [
  { name: "Sobre nosotros", url: "https://www.dacgrupo.com/##catalogo" },
  { name: "Marcas", url: "https://www.dacgrupo.com/#marcas" },
  { name: "Nuestros servicios", url: "https://www.dacgrupo.com/#nuestros_servicios" },
  { name: "Contáctanos", url: "https://www.dacgrupo.com/#contactanos" },
];

const logoUrl = "https://www.dacgrupo.com/wp-content/uploads/2021/05/dac_logo_4151.png";
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm h-25 flex items-center w-full">
  <div class="w-full px-6 md:px-12 flex justify-between items-center">
    <div id="logo_img" class="shrink-0">
      <a href="/">
        <img src={logoUrl} alt="DAC" class="h-13.75 w-auto object-contain" />
      </a>
    </div>

    <nav class="hidden md:block">
      <ul id="menu-principal" class="flex space-x-12">
        {
          navItems.map((item) => (
            <li>
              <a href={item.url} class="text-[14px] font-medium text-[#777] hover:text-[#333] transition-colors duration-300 tracking-[1px]">
                {item.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button id="menu-trigger" class="md:hidden text-[#777] p-2">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
      </svg>
    </button>
  </div>

  <MobileMenu />
</header>

<script>
  // Cuando se hace clic en el botón, lanzamos un evento que el MobileMenu escuchará
  const trigger = document.getElementById("menu-trigger");
  trigger?.addEventListener("click", () => {
    document.dispatchEvent(new Event("toggle-menu"));
  });
</script>

<style>
  /* Estilo extra para asegurar que las fuentes se parezcan a las de WordPress */
  #menu-principal a {
    letter-spacing: 0.5px;
    /* Evitamos que el azul de los enlaces por defecto aparezca */
    text-decoration: none;
  }
</style>
