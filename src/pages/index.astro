---
import Layout from "../layouts/Layout.astro";
// Importamos la función y la interfaz (usando type para la interfaz)
import { getWordPressContent, type WordPressData } from "../lib/wpData";

const content: WordPressData = await getWordPressContent();
---

<Layout title="DAC Grupo | Inicio">
  <div class="max-w-6xl mx-auto px-4 py-10 overflow-hidden">
    {content.sections.map((htmlChunk: string) => (
      <section class="wp-content"> <!-- Aplicamos la clase aquí -->
        <article set:html={htmlChunk} />
      </section>
    ))}
  </div>
</Layout>
